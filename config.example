# ccc config — OPTIONAL.
#
# You usually do NOT need this file: by default the app reads your existing
# Claude Code login from the Keychain and shows your usage automatically.
#
# This file is only for the advanced "bridge" mode — pointing ccc at a Claude
# usage bridge that stores the rate-limit headers (multi-account, zero-token
# reads). Copy to ~/.config/ccc/config and chmod 600, or just use the
# "Bridge settings…" item in the menu.

CCC_BRIDGE_URL="http://127.0.0.1:8787"
CCC_GLASSES_TOKEN="your-glasses-token-here"
CCC_FEDERATION_TOKEN="your-federation-token-here"
