#!/usr/bin/env python3
"""ccc-bar — Claude, Codex, Cursor, and Gemini usage in the macOS menu bar.

Zero setup: if you use Claude Code, the app reads its existing OAuth token from
your Keychain and makes one tiny probe call to read Anthropic's real
`anthropic-ratelimit-unified-*` headers (5h/7d utilization). Nothing to sign
into. Cursor and Gemini CLI are auto-detected the same way — no toggling
needed on a fresh install.

One menu-bar status item shows every detected, enabled provider's glyph +
value pair, side by side with a uniform gap between them; when a provider is
hidden in Settings or not detected on this machine, its pair drops out of the
title, and if every provider is hidden/undetected the item falls back to the
template terminal icon as a reachability anchor. A shared dropdown shows
color-coded progress bars and reset countdowns for each enabled provider.
A normal, quittable app — reopen via Spotlight/Applications,
`open -a "Claude Usage"`, or the `ccc` CLI.
"""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import threading
import time
import urllib.error
import urllib.request

import objc
import rumps
from AppKit import (NSApplication, NSBezierPath, NSColor,
                    NSCompositingOperationSourceAtop, NSFont,
                    NSFontAttributeName, NSForegroundColorAttributeName,
                    NSGraphicsContext, NSImage, NSRectFill,
                    NSRectFillUsingOperation, NSStatusBar, NSTextAttachment,
                    NSView)
from Foundation import (NSDistributedNotificationCenter, NSMakePoint,
                        NSMakeRect, NSMakeSize, NSMutableAttributedString,
                        NSAttributedString, NSObject, NSUserDefaults)
from PyObjCTools import AppHelper

ICON = os.path.expanduser("~/.config/ccc/icon.png")
REFRESH_SECONDS = 120
HTTP_TIMEOUT = 20
W_REG, W_SEMI = 0.0, 0.3
SEGMENT_GAP = "   "  # uniform gap between provider segments in the title

# ------------------------------------------------------------- bar row geometry
# Drawn dropdown bar row (mockup variation C, spec 2026-07-06 §5b). All values
# are the row's own view-local coordinates; the view is flipped (see
# BarRowView.isFlipped) so y grows downward from the row's top edge.
BAR_ROW_W = 250   # narrowed from 300 (Sam 2026-07-06): compactness is the point
BAR_ROW_H = 26
# Track start: the label column's widest possible value is "month" (the
# longest of the fixed label set 5h/7d/month/day), which measures ~37pt at
# 12pt semibold — verified directly with NSAttributedString.size() during
# development, since a naive ~30pt guess clipped it into "montl". 2pt left
# inset + ~37pt text + ~5pt breathing room before the track.
BAR_TRACK_X = 44
# % column: must fit the widest possible value, "est. 100%" (or "est. 120%"
# for an over-cap Gemini estimate), ~56.6pt at 11pt monospacedDigit semibold —
# 68 minus BAR_PCT_GAP and BAR_RIGHT_PAD leaves a 58pt text region.
BAR_TRACK_RIGHT_MARGIN = 68  # track ends at (width - this); rest is the % column
BAR_TRACK_H = 17
BAR_TRACK_RADIUS = 3.0    # near-rectangular with slight rounding (revised §5b)
BAR_PCT_GAP = 4           # gap between track's right edge and the % text region
BAR_RIGHT_PAD = 6         # inset from the view's right edge to the % text
BAR_INFILL_INSET = 10     # inset from an edge (fill or track) for countdown text
BAR_INFILL_PADDING = 20   # adaptive rule: fill must be >= text width + this
# Adaptive rule, second gate: countdown only goes INSIDE the fill when
# utilization is at least this fraction. Matches mockup C's picked look —
# mid-range rows (32/33/42%) keep the countdown in the empty region; only
# genuinely high fills (79%+) go battery-style, even though shorter countdown
# strings would technically fit inside smaller fills.
MIN_INFILL_FRACTION = 0.5
# Dotted text-bar texture (revised §5b — Sam's original ░/█ aesthetic):
# the empty region carries a dot grid like the old ░ shading; the fill is the
# plain vivid health color with faint vertical separators like adjacent █
# glyph boundaries.
BAR_DOT_D = 1.5           # dot diameter (~the old ░ speckle size)
BAR_DOT_PITCH = 4.5       # dot grid pitch, both axes
BAR_DOT_ALPHA = 0.5       # dots dimmed (Sam 2026-07-06: "less visible")
# Track background: near-black over the dark menu material (Sam's original
# track read ~#2b2b2d there); over a light menu it degrades to a medium gray.
BAR_TRACK_ALPHA = 0.25
# Dark, semibold countdown text drawn INSIDE a colored fill (battery-style).
BAR_INFILL_TEXT_COLOR = NSColor.colorWithCalibratedRed_green_blue_alpha_(
    0x1A / 255.0, 0x1A / 255.0, 0x1E / 255.0, 0.72)

KEYCHAIN_SERVICE = "Claude Code-credentials"
ANTHROPIC_MESSAGES = "https://api.anthropic.com/v1/messages"
R5_KEY = "anthropic-ratelimit-unified-5h-utilization"
R7_KEY = "anthropic-ratelimit-unified-7d-utilization"
RESET5_KEY = "anthropic-ratelimit-unified-5h-reset"
RESET7_KEY = "anthropic-ratelimit-unified-7d-reset"

GLYPH_CLAUDE = os.path.expanduser("~/.config/ccc/claude-glyph.png")
GLYPH_CODEX = os.path.expanduser("~/.config/ccc/codex-glyph.png")
GLYPH_CURSOR = os.path.expanduser("~/.config/ccc/cursor-glyph.png")
GLYPH_GEMINI = os.path.expanduser("~/.config/ccc/gemini-glyph.png")


def _load_helper(name):
    """Load a same-directory stdlib helper module (repo bin/ or ~/.local/bin).

    `name` is the file's own name (e.g. "ccc-codex"); the module name used for
    sys.modules bookkeeping is that with dashes stripped ("ccccodex"), same
    convention as the original ccc-codex-only loader this generalizes.
    """
    p = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    try:
        modname = name.replace("-", "")
        loader = importlib.machinery.SourceFileLoader(modname, p)
        spec = importlib.util.spec_from_loader(modname, loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:
        return None


_CODEX = _load_helper("ccc-codex")
_CURSOR = _load_helper("ccc-cursor")
_GEMINI = _load_helper("ccc-gemini")

DEFAULTS_SUITE = "com.claude-usage-bar"
SELFHEAL_KEY = "selfHeal"
SHOW_CLAUDE_KEY = "showClaude"
SHOW_CODEX_KEY = "showCodex"
SHOW_CURSOR_KEY = "showCursor"
SHOW_GEMINI_KEY = "showGemini"
GEMINI_CAP_KEY = "geminiDailyCap"
DEFAULT_GEMINI_CAP = 1000
# (label, daily request cap) — order is the Settings ▸ Gemini plan submenu order.
GEMINI_PLANS = (
    ("Free — 1000/day", 1000),
    ("AI Pro — 1500/day", 1500),
    ("AI Ultra — 2000/day", 2000),
    ("API key — 250/day", 250),
)

# NSStatusItem autosave name. macOS persists the named item's menu-bar
# position under "NSStatusItem Preferred Position <name>" in
# standardUserDefaults (required for position persistence since macOS 11 —
# see github.com/feedback-assistant/reports/issues/151).
AUTOSAVE_CLAUDE = "ccc-claude-item"


# ---------------------------------------------------------------- settings
def _defaults():
    # Named suite so the setting is stable regardless of how the app is
    # launched (LaunchAgent vs the .app launcher both exec the same unbundled
    # python, which would otherwise get an ambiguous defaults domain).
    return NSUserDefaults.alloc().initWithSuiteName_(DEFAULTS_SUITE)


def self_heal_enabled():
    d = _defaults()
    if d.objectForKey_(SELFHEAL_KEY) is None:
        return True  # default ON
    return bool(d.boolForKey_(SELFHEAL_KEY))


def set_self_heal(on):
    _defaults().setBool_forKey_(bool(on), SELFHEAL_KEY)


def provider_enabled(key):
    d = _defaults()
    if d.objectForKey_(key) is None:
        return True  # all providers default ON
    return bool(d.boolForKey_(key))


def set_provider_enabled(key, on):
    _defaults().setBool_forKey_(bool(on), key)


def gemini_cap():
    """Daily request cap used to compute Gemini's u5 fraction (default 1000)."""
    d = _defaults()
    if d.objectForKey_(GEMINI_CAP_KEY) is None:
        return DEFAULT_GEMINI_CAP
    n = int(d.integerForKey_(GEMINI_CAP_KEY))
    return n if n > 0 else DEFAULT_GEMINI_CAP


def set_gemini_cap(n):
    _defaults().setInteger_forKey_(int(n), GEMINI_CAP_KEY)


# ---------------------------------------------------------------- claude code
def claude_code_creds():
    """Read the OAuth token Claude Code stored in the login Keychain."""
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True, text=True, timeout=10)
        if out.returncode != 0 or not out.stdout.strip():
            return None
        data = json.loads(out.stdout)
        return data.get("claudeAiOauth", data)
    except Exception:
        return None


def probe_rate_headers(access_token):
    """Claude-Code-shaped probe; returns lowercased response-header dict.

    When you're maxed out, Anthropic rejects the probe with HTTP 429 — but that
    429 response *still carries* the anthropic-ratelimit-unified-* headers, so
    being at 100% is an answer, not a failure. We read the headers off the error
    response too. Only auth failures (401/403) re-raise, so the "login expired"
    path stays intact.
    """
    body = json.dumps({
        "model": "claude-haiku-4-5",
        "max_tokens": 1,
        "messages": [{"role": "user", "content": "x"}],
        "system": [{"type": "text",
                    "text": "You are Claude Code, Anthropic's official CLI for Claude."}],
    }).encode()
    req = urllib.request.Request(ANTHROPIC_MESSAGES, data=body, headers={
        "Authorization": f"Bearer {access_token}",
        "anthropic-version": "2023-06-01",
        "anthropic-beta": "oauth-2025-04-20",
        "content-type": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
            return {k.lower(): v for k, v in r.headers.items()}
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise
        return {k.lower(): v for k, v in e.headers.items()}


# ---------------------------------------------------------------- data fetch
def fetch():
    """Read the Claude Code login and probe once.

    Returns {'rate_headers': ..., 'plan': ...}, {'error': ...}, or None if no
    Claude Code login is available.
    """
    creds = claude_code_creds()
    if not (creds and creds.get("accessToken")):
        return None
    try:
        headers = probe_rate_headers(creds["accessToken"])
    except urllib.error.HTTPError as e:
        return {"error": "expired" if e.code in (401, 403) else True}
    except Exception:
        return {"error": True}
    # A 429 (maxed out) returns these headers too; a transient error (e.g.
    # overload) may not — only treat it as data when the usage is actually there.
    if R5_KEY not in headers and R7_KEY not in headers:
        return {"error": True}
    return {"rate_headers": headers, "plan": creds.get("subscriptionType")}


def claude_usage():
    """Normalize the probe result to the shared provider-record shape."""
    data = fetch()
    if data is None:
        return {"state": "no_login"}
    if data.get("error"):
        return {"state": "expired" if data["error"] == "expired" else "error"}
    rh = data["rate_headers"]

    def _i(v):
        try:
            return int(v)
        except (TypeError, ValueError):
            return None

    return {"state": "ok", "u5": f(rh.get(R5_KEY)), "u7": f(rh.get(R7_KEY)),
            "r5": _i(rh.get(RESET5_KEY)), "r7": _i(rh.get(RESET7_KEY)),
            "plan": (data.get("plan") or "").title() or None, "as_of": None}


def codex_usage():
    if _CODEX is None:
        return {"state": "no_data"}
    try:
        return _CODEX.codex_usage()
    except Exception:
        return {"state": "no_data"}


def cursor_usage():
    if _CURSOR is None:
        return {"state": "no_data"}
    try:
        return _CURSOR.cursor_usage()
    except Exception:
        return {"state": "no_data"}


def gemini_usage():
    if _GEMINI is None:
        return {"state": "no_data"}
    try:
        return _GEMINI.gemini_usage(cap=gemini_cap())
    except Exception:
        return {"state": "no_data"}


# Ordered: (record key, defaults key, glyph path, fetcher, text fallback,
#           window labels (label5, label7 or None), detect())
PROVIDERS = (
    ("claude", SHOW_CLAUDE_KEY, GLYPH_CLAUDE, claude_usage, "C:",
     ("5h", "7d"), lambda: claude_code_creds() is not None),
    ("codex", SHOW_CODEX_KEY, GLYPH_CODEX, codex_usage, "X:",
     ("5h", "7d"), lambda: _CODEX is not None and _CODEX.codex_detected()),
    ("cursor", SHOW_CURSOR_KEY, GLYPH_CURSOR, cursor_usage, "R:",
     ("month", None), lambda: _CURSOR is not None and _CURSOR.cursor_detected()),
    ("gemini", SHOW_GEMINI_KEY, GLYPH_GEMINI, gemini_usage, "G:",
     ("day", None), lambda: _GEMINI is not None and _GEMINI.gemini_detected()),
)


# ---------------------------------------------------------------- formatting
def f(util):
    try:
        return float(util)
    except (TypeError, ValueError):
        return None


def pct(util):
    u = f(util)
    return f"{u * 100:.0f}%" if u is not None else "?"


def health_color(util):
    u = f(util) or 0.0
    if u >= 0.8:
        return NSColor.systemRedColor()
    if u >= 0.5:
        return NSColor.systemOrangeColor()
    return NSColor.systemGreenColor()


def countdown(ts):
    try:
        ts = int(ts)
    except (TypeError, ValueError):
        return "—"
    d = ts - int(time.time())
    if d < 0:
        return "now"
    if d >= 86400:
        return f"{d // 86400}d {(d % 86400) // 3600}h"
    return f"{d // 3600}h {(d % 3600) // 60:02d}m"


def _age(ts):
    d = max(0, int(time.time()) - int(ts))
    if d >= 86400:
        return f"{d // 86400}d"
    if d >= 3600:
        return f"{d // 3600}h {(d % 3600) // 60}m"
    return f"{d // 60}m"


def _seg_font(text, color, font):
    return NSAttributedString.alloc().initWithString_attributes_(
        text, {NSFontAttributeName: font, NSForegroundColorAttributeName: color})


def _seg(text, color, size=12, weight=W_REG):
    font = NSFont.monospacedSystemFontOfSize_weight_(size, weight)
    return _seg_font(text, color, font)


class BarRowView(NSView):
    """One drawn usage-bar row (mockup variation C): label, rounded track with
    a health-color fill, an adaptive in-bar reset countdown, and the percent
    outside the track. Used as a dropdown NSMenuItem's custom view via
    `setView_`; all geometry lives in the BAR_* module constants above.

    No timers/animation here — the menu rebuilds the view from scratch on
    every refresh, so drawRect_ only ever needs to render one static frame.
    """

    def initWithLabel_util_resetEpoch_estimated_pct_(self, label_text, util,
                                                      reset_epoch, estimated,
                                                      real_pct):
        # objc.super (not plain super()) — a custom-named PyObjC initializer
        # calling an inherited selector other than its own name needs the
        # explicit ObjC super proxy, or the call raises AttributeError.
        self = objc.super(BarRowView, self).initWithFrame_(
            NSMakeRect(0, 0, BAR_ROW_W, BAR_ROW_H))
        if self is None:
            return None
        self._label_text = label_text
        self._util = util
        self._reset_epoch = reset_epoch
        self._estimated = estimated
        # Unclamped real fraction (may exceed 1.0, e.g. Gemini over its daily
        # cap): drives the displayed "est. NN%" text only — the fill always
        # uses the clamped `util`. None → fall back to util for the text too.
        self._real_pct = real_pct
        return self

    def isFlipped(self):
        # Top-left origin, y grows downward — lets every rect below be
        # positioned by its distance from the row's top edge, the way the
        # layout constants above are written.
        return True

    def _center_y(self, total_h, item_h):
        return (total_h - item_h) / 2.0

    def drawRect_(self, rect):
        # Text is measured/drawn via NSAttributedString (._seg_font(), .size(),
        # .drawAtPoint_()) rather than the NSString sizeWithAttributes_/
        # drawAtPoint_withAttributes_ category methods — those categories
        # don't reliably bridge onto plain python str in this environment
        # (crashes past the Python layer with no catchable exception), while
        # NSAttributedString is already this file's established idiom for
        # every other piece of drawn text (_seg/_seg_font, used since v1).
        bounds = self.bounds()
        w, h = bounds.size.width, bounds.size.height
        u = max(0.0, min(1.0, f(self._util) or 0.0))
        hc = health_color(self._util)

        # -- label (left column) --------------------------------------
        label_font = NSFont.monospacedSystemFontOfSize_weight_(12, W_SEMI)
        label_str = _seg_font(self._label_text, NSColor.labelColor(), label_font)
        label_size = label_str.size()
        label_str.drawAtPoint_(NSMakePoint(2, self._center_y(h, label_size.height)))

        # -- track: near-black, near-rectangular (3pt radius) rect — the
        #    backdrop the ░-style dot grid sits on (revised §5b) -----------
        track_w = max(0.0, w - BAR_TRACK_RIGHT_MARGIN - BAR_TRACK_X)
        track_y = self._center_y(h, BAR_TRACK_H)
        track_rect = NSMakeRect(BAR_TRACK_X, track_y, track_w, BAR_TRACK_H)
        track_path = NSBezierPath.bezierPathWithRoundedRect_xRadius_yRadius_(
            track_rect, BAR_TRACK_RADIUS, BAR_TRACK_RADIUS)
        NSColor.blackColor().colorWithAlphaComponent_(BAR_TRACK_ALPHA).set()
        track_path.fill()

        fill_w = round(track_w * u)
        fill_right = BAR_TRACK_X + fill_w
        ctx = NSGraphicsContext.currentContext()

        # -- dot grid in the EMPTY region only (the old ░ shading):
        #    ~1.5pt dots on a regular ~4.5pt pitch, dim dynamic color,
        #    clipped to the track's rounded path ---------------------------
        ctx.saveGraphicsState()
        track_path.addClip()
        NSColor.tertiaryLabelColor().colorWithAlphaComponent_(BAR_DOT_ALPHA).set()
        n_rows = int((BAR_TRACK_H - BAR_DOT_D) // BAR_DOT_PITCH) + 1
        grid_h = (n_rows - 1) * BAR_DOT_PITCH + BAR_DOT_D
        dot_y0 = track_y + (BAR_TRACK_H - grid_h) / 2.0
        x = BAR_TRACK_X + BAR_DOT_PITCH / 2.0
        x_end = BAR_TRACK_X + track_w - BAR_DOT_D
        while x <= x_end:
            if x >= fill_right + 1.0:  # dots never under the fill
                for r in range(n_rows):
                    NSBezierPath.bezierPathWithOvalInRect_(NSMakeRect(
                        x, dot_y0 + r * BAR_DOT_PITCH,
                        BAR_DOT_D, BAR_DOT_D)).fill()
            x += BAR_DOT_PITCH
        ctx.restoreGraphicsState()

        # -- fill: smooth, plain vivid health color (Sam 2026-07-06: no
        #    segment separators). Left corners follow the track radius via
        #    the clip; the right edge stays straight ----------------------
        if fill_w > 0:
            fill_rect = NSMakeRect(BAR_TRACK_X, track_y, fill_w, BAR_TRACK_H)
            ctx.saveGraphicsState()
            track_path.addClip()
            hc.set()
            NSRectFill(fill_rect)
            ctx.restoreGraphicsState()

        # -- percent, OUTSIDE the track, right-aligned, health color -------
        if self._estimated:
            # Real (unclamped) estimate when available — an over-cap Gemini
            # day reads "est. 120%" while the fill itself stays capped.
            rp = f(self._real_pct)
            pct_text = (f"est. {round(rp * 100)}%" if rp is not None
                        else f"est. {pct(self._util)}")
        else:
            pct_text = pct(self._util)
        pct_region_right = w - BAR_RIGHT_PAD
        pct_region_left = w - BAR_TRACK_RIGHT_MARGIN + BAR_PCT_GAP
        pct_avail = max(0.0, pct_region_right - pct_region_left)
        pct_font = NSFont.monospacedDigitSystemFontOfSize_weight_(12, W_SEMI)
        pct_str = _seg_font(pct_text, hc, pct_font)
        pct_size = pct_str.size()
        if pct_size.width > pct_avail:
            # "est. NN%" can be wider than the reserved column at 12pt —
            # shrink once to 11pt rather than let it collide with the track.
            pct_font = NSFont.monospacedDigitSystemFontOfSize_weight_(11, W_SEMI)
            pct_str = _seg_font(pct_text, hc, pct_font)
            pct_size = pct_str.size()
        pct_str.drawAtPoint_(
            NSMakePoint(pct_region_right - pct_size.width,
                       self._center_y(h, pct_size.height)))

        # -- countdown, ADAPTIVE placement (spec §5b) -----------------------
        if not self._reset_epoch:
            return
        cd_text = countdown(self._reset_epoch)
        infill_font = NSFont.systemFontOfSize_weight_(11, W_SEMI)
        infill_str = _seg_font(cd_text, BAR_INFILL_TEXT_COLOR, infill_font)
        cd_size = infill_str.size()
        if (u >= MIN_INFILL_FRACTION
                and fill_w >= cd_size.width + BAR_INFILL_PADDING):
            # Fits inside the fill: dark semibold text, right-aligned at the
            # fill's own right edge (battery-style).
            x = BAR_TRACK_X + fill_w - BAR_INFILL_INSET - cd_size.width
            infill_str.drawAtPoint_(NSMakePoint(x, self._center_y(h, cd_size.height)))
        else:
            # Falls back to the empty region, right-aligned, secondary color.
            outside_font = NSFont.systemFontOfSize_(11)
            outside_str = _seg_font(cd_text, NSColor.secondaryLabelColor(),
                                    outside_font)
            cd_size = outside_str.size()
            empty_left = BAR_TRACK_X + fill_w
            empty_right = BAR_TRACK_X + track_w
            x = max(empty_left, empty_right - BAR_INFILL_INSET - cd_size.width)
            outside_str.drawAtPoint_(NSMakePoint(x, self._center_y(h, cd_size.height)))


def info_row(text):
    return _seg(text, NSColor.secondaryLabelColor(), 11, W_REG)


# Per-provider, per-state dropdown copy for non-"ok" records. Keyed by the
# lowercased PROVIDERS record key so e.g. codex's "no_data" wording ("no
# sessions found") doesn't leak onto cursor/gemini's own "no_data" cases.
_STATE_MESSAGES = {
    "claude": {
        "no_login": "  No Claude Code login found — open Claude Code",
        "expired": "  Login expired — open Claude Code to refresh",
    },
    "codex": {
        "no_data": "  No Codex sessions found — run codex once",
    },
    "cursor": {
        "expired": "  Cursor login expired — open Cursor to refresh",
        "no_data": "  No Cursor usage data available",
    },
    "gemini": {
        "no_data": "  No Gemini sessions found — run gemini once",
    },
}


def _state_message(key, state):
    return _STATE_MESSAGES.get(key, {}).get(
        state, "  Couldn't read usage — try again shortly")


_GLYPH_CACHE = {}
_TINTED_CACHE = {}


def _glyph(path):
    """Base NSImage for a title glyph, or None (text fallback).

    Deliberately NOT a template image: the glyph is drawn via an
    NSTextAttachment inside an NSAttributedString title, and that text-layout
    drawing path ignores setTemplate_ auto-tinting (it only applies when
    NSButton/NSImageView draws the image directly). Tinting instead happens
    explicitly in _tinted_glyph() below, per the button's effective appearance.
    """
    if path not in _GLYPH_CACHE:
        img = NSImage.alloc().initWithContentsOfFile_(path)
        if img is not None:
            img.setSize_(NSMakeSize(15, 15))
        _GLYPH_CACHE[path] = img
    return _GLYPH_CACHE[path]


def _tinted_copy(img, color):
    """A solid-color copy of a black-on-transparent glyph (alpha preserved)."""
    t = img.copy()
    t.lockFocus()
    color.set()
    NSRectFillUsingOperation(((0, 0), t.size()), NSCompositingOperationSourceAtop)
    t.unlockFocus()
    return t


def _tinted_glyph(path, dark):
    """Cached white (dark menu bar) or black (light menu bar) glyph variant."""
    key = (path, dark)
    if key not in _TINTED_CACHE:
        base = _glyph(path)
        _TINTED_CACHE[key] = None if base is None else _tinted_copy(
            base, NSColor.whiteColor() if dark else NSColor.blackColor())
    return _TINTED_CACHE[key]


def _menu_bar_dark(button):
    """Best-effort read of whether the status item currently sits on a dark
    (Dark Aqua) menu bar, from the button's effective appearance."""
    try:
        ap = button.effectiveAppearance()
        name = ap.bestMatchFromAppearancesWithNames_(
            ["NSAppearanceNameAqua", "NSAppearanceNameDarkAqua"])
        return name == "NSAppearanceNameDarkAqua"
    except Exception:
        return True  # menu bars are most often dark; white glyph is the safer default


def _title_value(rec):
    if rec["state"] == "ok":
        if rec.get("estimated"):
            # Prefer the unclamped real fraction (spec §8) so an over-cap
            # Gemini day reads "est. 120%" even though u5 is capped at 1.0.
            rp = f(rec.get("pct"))
            if rp is not None:
                return f"est. {round(rp * 100)}%"
            return f"est. {pct(rec.get('u5'))}"
        return pct(rec.get("u5"))
    return "⚠" if rec["state"] in ("expired", "error") else "–"


def title_attr_string(entries, button):
    """entries: [(glyph_path, text_fallback, rec)] → attributed title.

    All enabled providers render as segments in the single status item's
    title, separated by a uniform SEGMENT_GAP. Glyph images ride in
    NSTextAttachments (bounds y-offset centers them on the menu-bar text
    baseline) and are tinted white/black to match the button's current
    (light/dark) menu-bar appearance, since the attachment drawing path
    doesn't honor NSImage template auto-tinting. Values use the system
    menu-bar font with monospaced digits (native SF Pro, matches the rest of
    the menu bar — no SF Mono width jitter).
    """
    dark = _menu_bar_dark(button)
    size = NSFont.menuBarFontOfSize_(0).pointSize()
    font = NSFont.monospacedDigitSystemFontOfSize_weight_(size, W_REG)
    color = NSColor.labelColor()
    s = NSMutableAttributedString.alloc().init()
    for i, (glyph_path, fallback, rec) in enumerate(entries):
        if i:
            s.appendAttributedString_(_seg_font(SEGMENT_GAP, color, font))
        img = _tinted_glyph(glyph_path, dark)
        if img is not None:
            att = NSTextAttachment.alloc().init()
            att.setImage_(img)
            att.setBounds_(NSMakeRect(0, -3, 15, 15))
            s.appendAttributedString_(
                NSAttributedString.attributedStringWithAttachment_(att))
            s.appendAttributedString_(_seg_font(" " + _title_value(rec), color, font))
        else:
            s.appendAttributedString_(_seg_font(fallback + _title_value(rec), color, font))
    return s


# ---------------------------------------------------------------- the app
_APP = None


class _MenuDelegate(NSObject):
    """Refresh the moment the user opens the menu, so it's always current."""
    def menuWillOpen_(self, menu):
        if _APP is not None:
            _APP.refresh(None)

    def themeChanged_(self, note):
        # Light/dark menu bar switch — repaint the title so glyphs re-tint
        # promptly instead of waiting for the next periodic tick.
        if _APP is not None:
            AppHelper.callAfter(_APP.refresh, None)


class CCCBar(rumps.App):
    def __init__(self):
        global _APP
        icon = ICON if os.path.exists(ICON) else None
        super().__init__("ccc", title=" …", icon=icon, template=True,
                         quit_button=None)
        try:
            NSApplication.sharedApplication().setActivationPolicy_(1)  # accessory
        except Exception:
            pass
        _APP = self
        self._refreshing = False
        self._refresh_again = False
        self._restoring = False
        self._rebuild_menu_next = True
        self._menu_delegate = _MenuDelegate.alloc().init()
        self._delegate_attached = False
        self._autosave_applied = False
        NSDistributedNotificationCenter.defaultCenter().addObserver_selector_name_object_(
            self._menu_delegate, "themeChanged:",
            "AppleInterfaceThemeChangedNotification", None)
        # Background ticks update only the menu-bar title (cheap, in place); they
        # do NOT rebuild the dropdown. The dropdown rebuilds on open / manual
        # refresh / after a wake-recreate.
        self.timer = rumps.Timer(self._tick, REFRESH_SECONDS)
        self.timer.start()
        # Recreate the status item after macOS wake — the icon's main vanish
        # cause, and there's no in-process way to detect the eviction.
        rumps.events.on_wake.register(self._on_wake)
        self.refresh(None)

    def _attach_open_delegate(self):
        # Attach once the NSMenu exists, so opening the dropdown triggers a refresh.
        if self._delegate_attached:
            return
        try:
            self._menu._menu.setDelegate_(self._menu_delegate)
            self._delegate_attached = True
        except Exception:
            pass

    def noop(self, _):
        pass

    def _attr_item(self, key, attr_string):
        item = rumps.MenuItem(key, callback=self.noop)
        item._menuitem.setAttributedTitle_(attr_string)
        return item

    def _bar_item(self, key, label, util, reset_epoch, estimated, real_pct):
        # No callback: a custom-view NSMenuItem doesn't need the highlight
        # machinery a callback brings — the row isn't interactive.
        item = rumps.MenuItem(key)
        view = BarRowView.alloc().initWithLabel_util_resetEpoch_estimated_pct_(
            label, util, reset_epoch, estimated, real_pct)
        item._menuitem.setView_(view)
        return item

    def _menu_tail(self):
        settings = rumps.MenuItem("Settings")
        show_c = rumps.MenuItem("Show Claude",
                                callback=lambda s: self._toggle_provider(s, SHOW_CLAUDE_KEY))
        show_c.state = 1 if provider_enabled(SHOW_CLAUDE_KEY) else 0
        show_x = rumps.MenuItem("Show Codex",
                                callback=lambda s: self._toggle_provider(s, SHOW_CODEX_KEY))
        show_x.state = 1 if provider_enabled(SHOW_CODEX_KEY) else 0
        show_r = rumps.MenuItem("Show Cursor",
                                callback=lambda s: self._toggle_provider(s, SHOW_CURSOR_KEY))
        show_r.state = 1 if provider_enabled(SHOW_CURSOR_KEY) else 0
        show_g = rumps.MenuItem("Show Gemini",
                                callback=lambda s: self._toggle_provider(s, SHOW_GEMINI_KEY))
        show_g.state = 1 if provider_enabled(SHOW_GEMINI_KEY) else 0
        gemini_plan = rumps.MenuItem("Gemini plan")
        current_cap = gemini_cap()
        gemini_plan.update([self._gemini_plan_item(label, cap, current_cap)
                            for label, cap in GEMINI_PLANS])
        heal = rumps.MenuItem("Auto-restore icon", callback=self.toggle_self_heal)
        heal.state = 1 if self_heal_enabled() else 0
        settings.update([show_c, show_x, show_r, show_g, gemini_plan, heal])
        return [
            None,
            rumps.MenuItem("Refresh now", callback=self.refresh),
            settings,
            rumps.MenuItem("Open in Terminal", callback=self.open_terminal),
            rumps.MenuItem("Quit", callback=rumps.quit_application),
        ]

    def refresh(self, _, rebuild_menu=True):
        # Probe is a network call — run it off the main thread so opening the
        # menu never blocks. Apply the result back on the main thread.
        if self._refreshing:
            # A refresh is already in flight (e.g. the dropdown-open probe) —
            # this call would otherwise be silently dropped. Queue it so a
            # toggle/manual refresh that lands mid-probe still takes effect
            # once the in-flight one finishes, instead of waiting up to
            # REFRESH_SECONDS for the next periodic tick.
            self._refresh_again = True
            return
        self._refreshing = True
        self._rebuild_menu_next = rebuild_menu
        threading.Thread(target=self._refresh_worker, daemon=True).start()

    def _tick(self, _):
        # Periodic background refresh: update the title only, no dropdown rebuild.
        self.refresh(None, rebuild_menu=False)

    def _on_wake(self, *_):
        # Fired by rumps on NSWorkspaceDidWakeNotification (main thread). Recreate
        # unconditionally — the icon may have been evicted and we can't tell.
        if self_heal_enabled():
            AppHelper.callAfter(self._restore_status_item)

    def _restore_status_item(self):
        # Remove the (possibly evicted) status item and make a fresh one, so the
        # icon is guaranteed present after a wake. Guarded against re-entry.
        if self._restoring:
            return
        self._restoring = True
        try:
            old = getattr(self._nsapp, "nsstatusitem", None)
            if old is not None:
                NSStatusBar.systemStatusBar().removeStatusItem_(old)
            self._nsapp.initializeStatusBar()
            try:
                self._nsapp.nsstatusitem.setAutosaveName_(AUTOSAVE_CLAUDE)
            except Exception:
                pass
            self._delegate_attached = False
        except Exception:
            pass
        finally:
            self._restoring = False
        self.refresh(None)  # repaint title + rebuild dropdown on the fresh item
        # A just-recreated button may not have resolved its effective
        # (light/dark) appearance yet, so the first tint can come out wrong
        # (invisible glyph) — one delayed repaint fixes it.
        AppHelper.callLater(0.5, self.refresh, None)

    def _refresh_worker(self):
        try:
            # Detect once per tick, then fetch only providers that are BOTH
            # detected on this machine AND enabled in Settings — an
            # undetected/hidden provider costs no probe at all. A provider
            # missing from `data` is simply absent from the title and the
            # dropdown, so detection and display can't disagree.
            data = {}
            for key, setting, _glyph_path, fetcher, _fb, _labels, detect in PROVIDERS:
                try:
                    detected = bool(detect())
                except Exception:
                    detected = False
                if detected and provider_enabled(setting):
                    data[key] = fetcher()
        finally:
            self._refreshing = False
        AppHelper.callAfter(self._apply, data)

    def _apply(self, data):
        if not self._autosave_applied:
            # The rumps status item only exists once run() has started
            # (rumps assigns self._nsapp inside run(), after __init__), and
            # _apply — via callAfter — is the first main-thread hook after
            # that, so the autosave name is attached here, once per launch.
            try:
                self._nsapp.nsstatusitem.setAutosaveName_(AUTOSAVE_CLAUDE)
                self._autosave_applied = True
            except Exception:
                pass
        rebuild = self._rebuild_menu_next
        entries = [(g, fb, data[k]) for k, s, g, fetch_, fb, _labels, _d in PROVIDERS
                   if k in data]
        if not entries:
            # No providers enabled: show the app icon so the item stays
            # clickable, clear the title.
            self.icon = ICON if os.path.exists(ICON) else None
            self.title = ""
        else:
            self.icon = None
            self.title = ""  # rumps clears the plain title...
            try:              # ...then the attributed one paints over it.
                btn = self._nsapp.nsstatusitem.button()
                btn.setAttributedTitle_(title_attr_string(entries, btn))
            except Exception:
                # No button API (very old macOS) — plain-text fallback.
                self.title = SEGMENT_GAP.join(
                    fb + _title_value(rec) for _g, fb, rec in entries)
        if rebuild:
            self._show(data)

        if self._refresh_again:
            # A refresh landed while this one was in flight (see refresh()) —
            # run it now that painting is done, rather than dropping it.
            self._refresh_again = False
            self.refresh(None)

    def _section_rows(self, name, rec, labels):
        rows = []
        head = name + (f" · {rec['plan']}" if rec.get("plan") else "")
        as_of = rec.get("as_of")
        if as_of and time.time() - as_of > REFRESH_SECONDS:
            head += f"   · as of {_age(as_of)} ago"
        if rec.get("stale"):
            head += " · cached"
        rows.append(self._attr_item(name + "_hdr", info_row(head)))
        state = rec["state"]
        if state == "ok":
            label5, label7 = labels
            estimated = bool(rec.get("estimated"))
            # The reset countdown now lives INSIDE the drawn bar (adaptive
            # rule, spec §5b) — the separate "resets …" info row is gone.
            if label5 is not None:
                # rec["pct"] (unclamped real fraction, spec §8) belongs to the
                # 5h/primary window only — the u7 row never carries it.
                rows.append(self._bar_item(
                    name + "_5h", label5, rec.get("u5"), rec.get("r5") or None,
                    estimated, rec.get("pct")))
            if label7 is not None:
                rows.append(self._bar_item(
                    name + "_7d", label7, rec.get("u7"), rec.get("r7") or None,
                    estimated, None))
            if estimated:
                rows.append(self._attr_item(
                    name + "_est", info_row("  estimated from local session logs")))
        else:
            rows.append(self._attr_item(
                name + "_err", info_row(_state_message(name.lower(), state))))
        return rows

    def _show(self, data):
        items = [self._attr_item("hdr", info_row("usage")), None]
        first = True
        for key, setting, _g, _f, _fb, labels, _detect in PROVIDERS:
            if key not in data:
                continue
            if not first:
                items.append(None)
            first = False
            items += self._section_rows(key.title(), data[key], labels)
        if first:  # nothing enabled
            items.append(self._attr_item("none", info_row("All providers hidden — Settings ▸")))
        items += self._menu_tail()
        self.menu.clear()
        self.menu = items
        self._attach_open_delegate()

    # --------------------------------------------------- menu actions
    def toggle_self_heal(self, sender):
        new = not self_heal_enabled()
        set_self_heal(new)
        sender.state = 1 if new else 0

    def _toggle_provider(self, sender, key):
        new = not provider_enabled(key)
        set_provider_enabled(key, new)
        sender.state = 1 if new else 0
        self.refresh(None)  # repaint title + dropdown immediately

    def _gemini_plan_item(self, label, cap, current_cap):
        item = rumps.MenuItem(label, callback=self._pick_gemini_cap)
        item.state = 1 if cap == current_cap else 0
        return item

    def _pick_gemini_cap(self, sender):
        for label, cap in GEMINI_PLANS:
            if label == sender.title:
                set_gemini_cap(cap)
                break
        # Rebuild the dropdown so the picked item's checkmark (and every
        # other plan item's) reflects the new selection immediately.
        self.refresh(None)

    def open_terminal(self, _):
        subprocess.Popen(
            ["osascript", "-e",
             'tell application "Terminal" to do script "ccc --watch"',
             "-e", 'tell application "Terminal" to activate'])


if __name__ == "__main__":
    import socket
    import sys
    _guard = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        _guard.bind(("127.0.0.1", 49219))
    except OSError:
        sys.exit(0)
    CCCBar().run()
