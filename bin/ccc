#!/usr/bin/env bash
# ccc — Claude usage readout in the terminal, read from your Claude Code login.
# Reads the OAuth token Claude Code stored in your Keychain and makes one tiny
# probe to read Anthropic's real rate-limit utilization (not local estimates).
# Companion to the ccc-bar menu bar app — same data source.
#
# Usage:
#   ccc            one-shot readout, then exit
#   ccc --watch    live refresh (default every 5s; -w N to change)
#   ccc --json     print the raw rate-limit headers
#   ccc open       open the menu bar app (Claude Usage)
set -euo pipefail

WATCH=0; INTERVAL=5; JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --watch|-W) WATCH=1 ;;
    -w) shift; INTERVAL="${1:-5}" ;;
    --json|--raw) JSON=1 ;;
    open) open -a "Claude Usage" 2>/dev/null && exit 0
      _py="$HOME/.config/ccc/venv/bin/python"; _bar="$HOME/.local/bin/ccc-bar"
      if [ -x "$_py" ] && [ -f "$_bar" ]; then nohup "$_py" "$_bar" >/dev/null 2>&1 & exit 0; fi
      echo "ccc: Claude Usage app not found — run ./install.sh first" >&2; exit 1 ;;
    -h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "ccc: unknown arg: $1" >&2; exit 2 ;;
  esac; shift
done

if [ -t 1 ]; then
  C_RST=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_GRN=$'\033[32m'; C_YEL=$'\033[33m'; C_RED=$'\033[31m'; C_CYN=$'\033[36m'
else C_RST=""; C_DIM=""; C_BOLD=""; C_GRN=""; C_YEL=""; C_RED=""; C_CYN=""; fi

color_for() { awk -v u="$1" 'BEGIN{ if(u>=0.8)print "R"; else if(u>=0.5)print "Y"; else print "G" }'; }
colcode() { case "$1" in R) printf '%s' "$C_RED";; Y) printf '%s' "$C_YEL";; *) printf '%s' "$C_GRN";; esac; }

bar() { # $1=fraction  $2=R/Y/G
  local frac="$1" width=14 filled empty
  filled=$(awk -v f="$frac" -v w="$width" 'BEGIN{n=int(f*w+0.5); if(n>w)n=w; if(n<0)n=0; print n}')
  empty=$((width-filled))
  printf '%s' "$(colcode "$2")"
  [ "$filled" -gt 0 ] && printf '%0.s█' $(seq 1 "$filled")
  printf '%s' "$C_DIM"; [ "$empty" -gt 0 ] && printf '%0.s░' $(seq 1 "$empty"); printf '%s' "$C_RST"
}

countdown() { local t="$1" now d; now=$(date +%s)
  [ -z "$t" ] || [ "$t" = "null" ] && { echo "—"; return; }
  d=$((t-now)); [ "$d" -lt 0 ] && { echo "now"; return; }
  printf "%dh %02dm" "$((d/3600))" "$(((d%3600)/60))"; }

render() {
  local tok hdrs u5 u7 r5
  tok=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null | jq -r '(.claudeAiOauth // .).accessToken // empty' 2>/dev/null)
  if [ -z "$tok" ]; then
    echo "${C_RED}ccc: no Claude Code login found${C_RST} — open Claude Code" >&2
    return 1
  fi
  hdrs=$(curl -sS -D - -o /dev/null --max-time 20 https://api.anthropic.com/v1/messages \
    -H "Authorization: Bearer $tok" -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20" -H "content-type: application/json" \
    -d '{"model":"claude-haiku-4-5","max_tokens":1,"messages":[{"role":"user","content":"x"}],"system":[{"type":"text","text":"You are Claude Code, Anthropic'\''s official CLI for Claude."}]}' 2>/dev/null)
  if [ "$JSON" = "1" ]; then echo "$hdrs" | grep -i 'anthropic-ratelimit-unified' | tr -d '\r'; return 0; fi
  u5=$(echo "$hdrs" | awk -F': ' 'tolower($1)=="anthropic-ratelimit-unified-5h-utilization"{gsub(/\r/,"",$2);print $2}')
  u7=$(echo "$hdrs" | awk -F': ' 'tolower($1)=="anthropic-ratelimit-unified-7d-utilization"{gsub(/\r/,"",$2);print $2}')
  r5=$(echo "$hdrs" | awk -F': ' 'tolower($1)=="anthropic-ratelimit-unified-5h-reset"{gsub(/\r/,"",$2);print $2}')
  if [ -z "$u5" ]; then
    echo "${C_RED}ccc: couldn't read usage${C_RST} — your Claude Code login may be expired (open Claude Code)" >&2; return 1
  fi
  local c5 c7 p5 p7
  c5=$(color_for "$u5"); c7=$(color_for "$u7")
  p5=$(awk -v u="$u5" 'BEGIN{printf "%d",u*100+0.5}'); p7=$(awk -v u="$u7" 'BEGIN{printf "%d",u*100+0.5}')
  echo
  echo "  ${C_BOLD}${C_CYN}claude usage${C_RST}  ${C_DIM}· via Claude Code${C_RST}"
  echo
  printf "  5h  %s %s%3d%%%s\n" "$(bar "$u5" "$c5")" "$(colcode "$c5")" "$p5" "$C_RST"
  printf "  7d  %s %s%3d%%%s\n" "$(bar "$u7" "$c7")" "$(colcode "$c7")" "$p7" "$C_RST"
  echo
  printf "  ${C_DIM}5h resets %s${C_RST}\n" "$(countdown "$r5")"
  echo
}

helper() { # $1 = helper name — installed copy wins, else sibling of this script
  if [ -x "$HOME/.local/bin/$1" ]; then echo "$HOME/.local/bin/$1"
  else echo "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$1"; fi
}
codex_helper()  { helper ccc-codex; }
cursor_helper() { helper ccc-cursor; }
gemini_helper() { helper ccc-gemini; }

gemini_cap() { # daily request cap from the menu bar app's setting, else 1000
  local cap
  cap=$(defaults read com.claude-usage-bar geminiDailyCap 2>/dev/null) || cap=1000
  [[ "$cap" =~ ^[0-9]+$ ]] || cap=1000
  echo "$cap"
}

render_codex() {
  local rec state u5 u7 r5 asof c5 c7 p5 p7 agestr=""
  rec=$(python3 "$(codex_helper)" 2>/dev/null) || return 0
  state=$(echo "$rec" | jq -r '.state // empty' 2>/dev/null) || state=""
  if [ "$state" != "ok" ]; then
    echo "  ${C_BOLD}${C_CYN}codex usage${C_RST}   ${C_DIM}· no session data — run codex once${C_RST}"
    echo
    return 0
  fi
  u5=$(echo "$rec" | jq -r '.u5 // 0' 2>/dev/null) || u5=0
  u7=$(echo "$rec" | jq -r '.u7 // 0' 2>/dev/null) || u7=0
  r5=$(echo "$rec" | jq -r '.r5 // empty' 2>/dev/null) || r5=""
  asof=$(echo "$rec" | jq -r '.as_of // empty' 2>/dev/null) || asof=""
  [[ "$asof" =~ ^[0-9]+$ ]] || asof=""
  [[ "$r5" =~ ^[0-9]+$ ]] || r5=""
  if [ -n "$asof" ]; then
    local age=$(( $(date +%s) - asof ))
    [ "$age" -gt 120 ] && agestr=" · $((age/60))m ago"
  fi
  c5=$(color_for "$u5"); c7=$(color_for "$u7")
  p5=$(awk -v u="$u5" 'BEGIN{printf "%d",u*100+0.5}'); p7=$(awk -v u="$u7" 'BEGIN{printf "%d",u*100+0.5}')
  echo "  ${C_BOLD}${C_CYN}codex usage${C_RST}  ${C_DIM}· via session log${agestr}${C_RST}"
  echo
  printf "  5h  %s %s%3d%%%s\n" "$(bar "$u5" "$c5")" "$(colcode "$c5")" "$p5" "$C_RST"
  printf "  7d  %s %s%3d%%%s\n" "$(bar "$u7" "$c7")" "$(colcode "$c7")" "$p7" "$C_RST"
  echo
  [ -n "$r5" ] && printf "  ${C_DIM}5h resets %s${C_RST}\n" "$(countdown "$r5")" && echo
  return 0
}

render_cursor() {
  local rec state u5 r5 asof plan stale c5 p5 head agestr=""
  python3 "$(cursor_helper)" --detect >/dev/null 2>&1 || return 0
  rec=$(python3 "$(cursor_helper)" 2>/dev/null) || return 0
  state=$(echo "$rec" | jq -r '.state // empty' 2>/dev/null) || state=""
  if [ "$state" != "ok" ]; then
    if [ "$state" = "expired" ]; then
      echo "  ${C_BOLD}${C_CYN}cursor usage${C_RST}  ${C_DIM}· login expired — open Cursor to refresh${C_RST}"
    else
      echo "  ${C_BOLD}${C_CYN}cursor usage${C_RST}  ${C_DIM}· no usage data available${C_RST}"
    fi
    echo
    return 0
  fi
  u5=$(echo "$rec" | jq -r '.u5 // 0' 2>/dev/null) || u5=0
  r5=$(echo "$rec" | jq -r '.r5 // empty' 2>/dev/null) || r5=""
  asof=$(echo "$rec" | jq -r '.as_of // empty' 2>/dev/null) || asof=""
  plan=$(echo "$rec" | jq -r '.plan // empty' 2>/dev/null) || plan=""
  stale=$(echo "$rec" | jq -r '.stale // false' 2>/dev/null) || stale="false"
  [[ "$asof" =~ ^[0-9]+$ ]] || asof=""
  [[ "$r5" =~ ^[0-9]+$ ]] || r5=""
  if [ -n "$asof" ]; then
    local age=$(( $(date +%s) - asof ))
    [ "$age" -gt 120 ] && agestr=" · $((age/60))m ago"
  fi
  head="· month"
  [ -n "$plan" ] && head="· $plan · month"
  [ "$stale" = "true" ] && head="$head · cached"
  c5=$(color_for "$u5")
  p5=$(awk -v u="$u5" 'BEGIN{printf "%d",u*100+0.5}')
  echo "  ${C_BOLD}${C_CYN}cursor usage${C_RST}  ${C_DIM}${head}${agestr}${C_RST}"
  echo
  printf "  mo  %s %s%3d%%%s\n" "$(bar "$u5" "$c5")" "$(colcode "$c5")" "$p5" "$C_RST"
  echo
  [ -n "$r5" ] && printf "  ${C_DIM}month resets %s${C_RST}\n" "$(countdown "$r5")" && echo
  return 0
}

render_gemini() {
  local rec state u5 r5 pct c5 p5
  python3 "$(gemini_helper)" --detect >/dev/null 2>&1 || return 0
  rec=$(python3 "$(gemini_helper)" --cap "$(gemini_cap)" 2>/dev/null) || return 0
  state=$(echo "$rec" | jq -r '.state // empty' 2>/dev/null) || state=""
  if [ "$state" != "ok" ]; then
    echo "  ${C_BOLD}${C_CYN}gemini usage${C_RST}  ${C_DIM}· no session data — run gemini once${C_RST}"
    echo
    return 0
  fi
  u5=$(echo "$rec" | jq -r '.u5 // 0' 2>/dev/null) || u5=0
  r5=$(echo "$rec" | jq -r '.r5 // empty' 2>/dev/null) || r5=""
  pct=$(echo "$rec" | jq -r '.pct // empty' 2>/dev/null) || pct=""
  [[ "$r5" =~ ^[0-9]+$ ]] || r5=""
  [[ "$pct" =~ ^[0-9]+(\.[0-9]+)?$ ]] || pct=""
  c5=$(color_for "$u5")
  # Displayed percentage is the UNCLAMPED estimate (.pct) when present —
  # "est. 120%" over a bar capped at 100% — else the clamped u5.
  if [ -n "$pct" ]; then p5=$(awk -v p="$pct" 'BEGIN{printf "%d",p*100+0.5}')
  else p5=$(awk -v u="$u5" 'BEGIN{printf "%d",u*100+0.5}'); fi
  echo "  ${C_BOLD}${C_CYN}gemini usage${C_RST}  ${C_DIM}· est. · day${C_RST}"
  echo
  printf "  day %s %sest. %d%%%s\n" "$(bar "$u5" "$c5")" "$(colcode "$c5")" "$p5" "$C_RST"
  echo
  [ -n "$r5" ] && printf "  ${C_DIM}day resets %s${C_RST}\n" "$(countdown "$r5")"
  printf "  ${C_DIM}estimated from local session logs${C_RST}\n"
  echo
  return 0
}

if [ "$WATCH" = "1" ] && [ "$JSON" != "1" ]; then
  trap 'tput cnorm 2>/dev/null; exit 0' INT TERM
  tput civis 2>/dev/null || true
  while true; do clear; render || true; render_codex || true; render_cursor || true; render_gemini || true
    printf "  ${C_DIM}refreshing every %ss · ctrl-c to quit${C_RST}\n" "$INTERVAL"; sleep "$INTERVAL"; done
else
  rc=0; render || rc=$?
  if [ "$JSON" = "1" ]; then
    python3 "$(codex_helper)" 2>/dev/null || true
    if python3 "$(cursor_helper)" --detect >/dev/null 2>&1; then
      python3 "$(cursor_helper)" 2>/dev/null || true
    fi
    if python3 "$(gemini_helper)" --detect >/dev/null 2>&1; then
      python3 "$(gemini_helper)" --cap "$(gemini_cap)" 2>/dev/null || true
    fi
  else render_codex || true; render_cursor || true; render_gemini || true; fi
  exit "$rc"
fi
